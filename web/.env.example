# Copy this file to .env.local for local development.
# Never prefix server secrets with NEXT_PUBLIC_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
APP_BASE_URL=http://localhost:3000

# Use a non-production Atlas database for local and Netlify development deployments.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=colaboradores_dna_dev

# Required only when reading or writing synthetic collaborator-development records.
# Generate a local key with: openssl rand -base64 32
# Keep these server-only. Do not configure them in untrusted Deploy Previews.
DEVELOPMENT_ENCRYPTION_ACTIVE_KEY_VERSION=v1
DEVELOPMENT_ENCRYPTION_KEY_V1=<base64-encoded-32-byte-key>
# Controlled, one-time administrator bootstrap. Remove values after use.
BOOTSTRAP_ENVIRONMENT=development
BOOTSTRAP_ADMIN_IDENTITIES=[{"email":"admin@example.com","displayName":"Nombre Administrador"}]
# Required only for an explicitly approved production bootstrap:
# ALLOW_PRODUCTION_ADMIN_BOOTSTRAP=true
