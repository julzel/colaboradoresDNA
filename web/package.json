{
  "name": "colaboradores-dna-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "bootstrap:admins": "node --env-file=.env.local scripts/bootstrap-admins.mjs",
    "bootstrap:employee-model": "node --env-file=.env.local scripts/bootstrap-employee-model.mjs",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "netlify:preview": "node scripts/verify-netlify-preview.mjs && pnpm verify",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stylelint": "stylelint \"src/**/*.css\"",
    "verify": "pnpm format:check && pnpm lint && pnpm stylelint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@clerk/backend": "3.13.2",
    "@clerk/localizations": "^4.13.8",
    "@clerk/nextjs": "^7.6.2",
    "lucide-react": "^1.27.0",
    "mongodb": "7.5.0",
    "next": "16.2.12",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "sonner": "^2.0.7",
    "zod": "4.3.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.55.0",
    "@testing-library/jest-dom": "6.6.4",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "9.34.0",
    "eslint-config-next": "16.2.12",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "sharp": "0.34.5",
    "stylelint": "16.23.1",
    "stylelint-config-standard": "39.0.0",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.4"
  }
}
