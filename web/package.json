{
  "name": "colaboradores-dna-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/verify-netlify-preview.mjs && next build",
    "bootstrap:admins": "tsx --conditions=react-server --env-file=.env.local scripts/bootstrap-admins.mts",
    "bootstrap:employee-model": "node --env-file=.env.local scripts/bootstrap-employee-model.mjs",
    "bootstrap:development-model": "node --env-file=.env.local scripts/bootstrap-development-model.mjs",
    "bootstrap:pto-model": "node --env-file=.env.local scripts/bootstrap-pto-model.mjs",
    "bootstrap:production-tasks-model": "node --env-file=.env.local scripts/bootstrap-production-tasks-model.mjs",
    "bootstrap:scheduling-model": "node --env-file=.env.local scripts/bootstrap-scheduling-model.mjs",
    "generate:pwa-icons": "node scripts/generate-pwa-icons.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:tasks:integration": "node scripts/test-production-tasks-local.mjs",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "stylelint": "stylelint \"src/**/*.css\"",
    "verify": "pnpm format:check && pnpm lint && pnpm stylelint && pnpm typecheck && pnpm test && pnpm build",
    "bootstrap:auth": "tsx --conditions=react-server --env-file=.env.local scripts/bootstrap-auth.mts",
    "migrate:auth": "tsx --env-file=.env.local scripts/migrate-clerk-accounts.mts"
  },
  "dependencies": {
    "better-auth": "^1.7.3",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.27.0",
    "mongodb": "7.5.0",
    "next": "16.3.3",
    "nodemailer": "^10.0.1",
    "openai": "^7.10.0",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "sonner": "^2.0.7",
    "zod": "4.3.2"
  },
  "pnpm": {
    "overrides": {
      "sharp@<0.35.4": "0.35.4",
      "postcss@<8.5.23": "8.5.23",
      "nanoid@>=3 <3.3.18": "3.3.18",
      "brace-expansion@<2": "1.1.18",
      "brace-expansion@>=2 <2.1.4": "2.1.4",
      "brace-expansion@>=5 <5.0.9": "5.0.9",
      "fast-uri@>=3 <3.1.6": "3.1.6",
      "js-yaml@>=4 <4.3.2": "4.3.2",
      "colord@<2.9.4": "2.9.4",
      "exceljs>uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@netlify/plugin-nextjs": "^5.15.13",
    "@playwright/test": "1.55.1",
    "@testing-library/jest-dom": "6.6.4",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.3.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.34.0",
    "eslint-config-next": "16.3.3",
    "jsdom": "26.1.0",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "3.6.2",
    "stylelint": "16.23.1",
    "stylelint-config-standard": "39.0.0",
    "tsx": "^4.23.13",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "4.1.11"
  }
}
